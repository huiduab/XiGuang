<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Xiguang" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/xiguang_background</item>
        <item name="android:navigationBarColor">@color/xiguang_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Xiguang.Share" parent="Theme.Xiguang">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
