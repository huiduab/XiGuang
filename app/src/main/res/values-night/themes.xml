<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Xiguang" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#191C1A</item>
        <item name="android:navigationBarColor">#191C1A</item>
        <item name="android:windowActionModeOverlay">true</item>
